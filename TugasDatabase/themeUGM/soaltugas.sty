% -----------------------------------------------------------------------
% Paper formatting
% -----------------------------------------------------------------------

% Standardkommandos in LaTeX2e
\def\ensuremath#1{\relax\ifmmode #1\else $#1$\fi}

\parindent 0pt
\parskip   1ex plus 0.3ex minus 0.3ex
%\parskip   6pt plus 2pt minus 2pt

%\textheight 23.9cm
\textheight 23.9cm
\textwidth  16cm
\topmargin  -2cm
\leftmargin -1cm
\advance\hsize by 2truecm\hoffset = -1.5truecm

\frenchspacing
\sloppy

